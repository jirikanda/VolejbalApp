	<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Havit.ApplicationInsights.DependencyCollector" Version="2.0.11" />
    <PackageVersion Include="Havit.AspNetCore.Mvc" Version="2.0.31" />
    <PackageVersion Include="Havit.Core" Version="2.0.50" />
    <PackageVersion Include="Havit.Blazor.Storage" Version="1.0.5" />
    <PackageVersion Include="Havit.Extensions.DependencyInjection" Version="2.0.15" />
    <PackageVersion Include="Havit.Extensions.DependencyInjection.Abstractions" Version="2.0.23" />
    <PackageVersion Include="Microsoft.ApplicationInsights.DependencyCollector" Version="2.23.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <!-- Jen MigrationTool: jednorázový převod dat ze SQL Serveru do Cosmosu. Po převodu ho lze
         i s tím projektem vyhodit, aplikace na SQL Server nesahá. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <!-- Jen tranzitivní (přímo ho nic nereferencuje), ale přes transitive pinning zvedá celou rodinu
         Microsoft.Extensions.*.Abstractions na aktuální patch; bez něj spadne na nižší patch. Držet na verzi
         Microsoft.Extensions.Hosting. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- MCP server (Api, trigger /mcp): oficiální C# SDK, z něj se používá HTTP handler za MapMcp(),
         viz Api/Mcp/McpRequestHandler.cs. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="MSTest" Version="4.5.3" />
    <!-- Nutná závislost Cosmos SDK, i když ji náš kód nepoužívá - podrobnosti u reference
         v src/DataLayer/DataLayer.csproj. SDK se váže na 10.0.0.0, novější verze vezme zavděk. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
  </ItemGroup>
</Project>
