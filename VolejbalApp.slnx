  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>
  <Project Path="src/Contracts/Contracts.csproj" />
  <Project Path="src/DataLayer/DataLayer.csproj" />
  <Project Path="src/DependencyInjection/DependencyInjection.csproj" />
  <Project Path="src/Entity/Entity.csproj" />
  <Project Path="src/Facades/Facades.csproj" />
  <Project Path="src/MigrationTool/MigrationTool.csproj" />
  <Project Path="src/Model/Model.csproj" />
  <Project Path="src/Services/Services.csproj" />
  <Project Path="src/Tests/Tests.csproj" />
  <Project Path="src/TestsForLocalDebugging/TestsForLocalDebugging.csproj" />
  <Project Path="src/Web.Client/Web.Client.csproj" />
  <Project Path="src/Web/Web.csproj" />
  <Properties Name="Performance">
