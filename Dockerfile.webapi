# syntax=docker/dockerfile:1
# Multi-stage build pro VolejbalApp WebAPI.
# Build context je kořen repa, Dockerfile se předává přes -f:
#
#   docker build -f Dockerfile.webapi -t volejbalapp-webapi .
#   docker run --rm -p 8080:8080 -e ConnectionStrings__Database="..." volejbalapp-webapi

# ---- build ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
# Cache mount drží NuGet balíčky mezi buildy (restore netahá z netu při změně zdrojáku).
RUN --mount=type=cache,target=/root/.nuget/packages \
        dotnet publish WebAPI/WebAPI.csproj \
        --configuration Release \
        -p:ContinuousIntegrationBuild=true \
        --output /app/publish   

# ---- runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
USER $APP_UID

EXPOSE 8080

COPY --from=build /app/publish ./
ENTRYPOINT ["dotnet", "KandaEu.Volejbal.WebAPI.dll"]
