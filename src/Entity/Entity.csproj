<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>KandaEu.Volejbal.Entity</AssemblyName>
		<RootNamespace>KandaEu.Volejbal.Entity</RootNamespace>		
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KandaEu.Volejbal.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- Slouží jen EF tooling (VolejbalDesignTimeDbContextFactory, code generator), proto zůstává
		     v build outputu, ale do publish nesmí: hostitelské aplikace načítají appsettings.json jako
		     první konfigurační vrstvu, takže by se do nasazeného balíčku dostal zdejší LocalDB
		     connection string. Přebily by ho sice proměnné prostředí, ale kdyby jednou chyběly,
		     aplikace by místo hlasitého selhání tiše sáhla na neexistující lokální databázi. -->
		<Content Include="appsettings.json">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Havit.Data.EntityFrameworkCore" />
		<PackageReference Include="Havit.Data.EntityFrameworkCore.CodeGenerator" PrivateAssets="all" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Model\Model.csproj" />
	</ItemGroup>

</Project>
