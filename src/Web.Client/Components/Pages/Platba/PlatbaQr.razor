﻿@if (_qrSvg != null)
{
    <section class="pay">
        <div class="msg-head">
            <h2>QR platba</h2>
        </div>
        <div class="pay-card">
            <div class="pay-qr">@((MarkupString)_qrSvg)</div>
            <p class="pay-note">@_ucet@if (_castkaText != null){<text>, @_castkaText</text>}</p>
        </div>
    </section>
}
