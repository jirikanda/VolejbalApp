@using KandaEu.Volejbal.Contracts.Osoby.Dto

<div class="person-list">
    <h3>Hráči</h3>
    <p class="descr">Neaktivní hráči se nenabízejí k přihlášení na termíny. Aktivovat či deaktivovat se dá kdykoli.</p>

    @if (_osoby != null)
    {
        @if (_osoby.Osoby.Count == 0)
        {
            <div class="empty-block" style="padding: 24px 16px;">
                <strong>Žádní hráči</strong>
                Zatím není evidován žádný hráč.
            </div>
        }
        else
        {
            <table>
                <tbody>
                    @foreach (OsobaDto osoba in _osoby.Osoby)
                    {
                        <tr class="@(osoba.Aktivni ? null : "inactive")">
                            <td class="name">
                                @osoba.PrijmeniJmeno
                                @if (!osoba.Aktivni)
                                {
                                    <span class="state-tag">neaktivní</span>
                                }
                            </td>
                            <td class="actions">
                                @if (osoba.Aktivni)
                                {
                                    <button type="button" class="text-btn deactivate" @onclick="@(async () => await DeaktivovatAsync(osoba))">deaktivovat</button>
                                }
                                else
                                {
                                    <button type="button" class="text-btn activate" @onclick="@(async () => await AktivovatAsync(osoba))">aktivovat</button>
                                    <button type="button" class="text-btn del" @onclick="@(() => ZobrazPotvrzeniSmazani(osoba))">smazat</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@if (_osobaKeSmazani != null)
{
    <div class="modal-backdrop" tabindex="-1" @ref="_modalBackdrop"
         @onclick="ZavriPotvrzeniSmazani"
         @onkeydown="HandleModalKeyDown">
        <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="smazat-osobu-nadpis"
             @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 id="smazat-osobu-nadpis">Smazat osobu</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="ZavriPotvrzeniSmazani">&times;</button>
            </div>
            <div class="modal-body">
                Opravdu chceš smazat osobu &ldquo;@_osobaKeSmazani.PrijmeniJmeno&rdquo;?
            </div>
            <div class="modal-foot">
                <button type="button" @onclick="ZavriPotvrzeniSmazani">Zrušit</button>
                <button type="button" class="danger" @onclick="PotvrditSmazaniAsync">Smazat</button>
            </div>
        </div>
    </div>
}
