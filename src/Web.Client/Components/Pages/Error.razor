@page "/Error"

<PageTitle>Volejbal &#183; Chyba</PageTitle>

<div class="error-page">
    <svg class="error-illustration" viewBox="0 0 240 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <linearGradient id="error-ball-bg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FAEFD8" />
                <stop offset="100%" stop-color="#C7A26B" />
            </linearGradient>
        </defs>
        <path d="M12 136 H228" stroke="var(--line-strong)" stroke-width="2" stroke-linecap="round" />
        <ellipse cx="138" cy="137" rx="24" ry="3.5" fill="var(--line)" />
        <path d="M14 130 Q62 48 118 85" fill="none" stroke="var(--pending)" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="0.1 7" />
        <g transform="translate(138 88) rotate(-24) scale(1.9) translate(-12 -12)">
            <circle cx="12" cy="12" r="10" fill="url(#error-ball-bg)" stroke="#3D2817" stroke-width="1.2" />
            <g fill="none" stroke="#3D2817" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11.1 7.1a16.55 16.55 0 0 1 10.9 4" />
                <path d="M12 12a12.6 12.6 0 0 1-8.7 5" />
                <path d="M16.8 13.6a16.55 16.55 0 0 1-9 7.5" />
                <path d="M20.7 17a12.8 12.8 0 0 0-8.7-5 13.3 13.3 0 0 1 0-10" />
                <path d="M6.3 3.8a16.55 16.55 0 0 0 1.9 11.5" />
            </g>
        </g>
        <g fill="none" stroke="var(--ink-3)" stroke-width="1.1" stroke-linecap="round" opacity=".75">
            <path d="M56 55.6 C106 55.6 114 59.2 138 59.2 S170 55.6 216 55.6" />
            <path d="M56 65.2 C106 65.2 114 72.4 138 72.4 S170 65.2 216 65.2" />
            <path d="M56 74.8 C106 74.8 114 85.6 138 85.6 S170 74.8 216 74.8" />
            <path d="M56 84.4 C106 84.4 114 98.8 138 98.8 S170 84.4 216 84.4" />
            <path d="M66 46 Q65.9 74.1 66 94.2" />
            <path d="M76 46 Q75.8 74.3 75.9 94.6" />
            <path d="M86 46 Q85.4 74.9 85.7 95.7" />
            <path d="M96 46 Q94.7 76 95.2 97.9" />
            <path d="M106 46 Q103.5 77.7 104.5 101.4" />
            <path d="M116 46 Q112.1 79.9 113.6 105.8" />
            <path d="M126 46 Q120.7 81.9 122.8 109.9" />
            <path d="M136 46 Q130 83 132.4 111.9" />
            <path d="M146 46 Q151.7 82.5 149.4 111" />
            <path d="M156 46 Q160.5 80.8 158.7 107.6" />
            <path d="M166 46 Q169 78.6 167.8 103.1" />
            <path d="M176 46 Q177.7 76.6 177 99.2" />
            <path d="M186 46 Q186.8 75.2 186.5 96.5" />
            <path d="M196 46 Q196.3 74.5 196.2 95" />
            <path d="M206 46 Q206.1 74.2 206.1 94.3" />
        </g>
        <path d="M56 94.1 C106 94.1 114 111.9 138 111.9 S170 94.1 216 94.1" fill="none" stroke="var(--ink-2)" stroke-width="2" stroke-linecap="round" />
        <path d="M56 30 V136 M216 30 V136" stroke="var(--ink-2)" stroke-width="5" stroke-linecap="round" />
        <rect x="56" y="38" width="160" height="8" rx="2" fill="var(--surface)" stroke="var(--ink-2)" stroke-width="1.5" />
    </svg>

    <h2>Ups...</h2>

    <p class="error-lead">@_headline</p>

    @if (!String.IsNullOrEmpty(_hint))
    {
        <p class="error-hint">@_hint</p>
    }

    <p>Kliknutím <a href="#" @onclick="HandleRestartClick" @onclick:preventDefault>restartujete aplikaci</a>.</p>

    @if (Exception != null)
    {
        <details class="error-detail">
            <summary>Technické podrobnosti</summary>
            @if (!String.IsNullOrEmpty(_serverResponse))
            {
                <p class="error-detail-label">Odpověď serveru</p>
                <pre>@_serverResponse</pre>
            }
            <p class="error-detail-label">Výjimka</p>
            <pre>@Exception.ToString()</pre>
        </details>
    }
</div>
