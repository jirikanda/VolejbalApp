@page "/Error"

<PageTitle>Volejbal &#183; Chyba</PageTitle>

<div class="error-page">
    <h2>Ups...</h2>

    <p class="error-lead">@_headline</p>

    @if (!String.IsNullOrEmpty(_hint))
    {
        <p class="error-hint">@_hint</p>
    }

    <p>Kliknutím <a href="#" @onclick="HandleRestartClick" @onclick:preventDefault>restartujete aplikaci</a>.</p>

    @if (Exception != null)
    {
        <details class="error-detail">
            <summary>Technické podrobnosti</summary>
            @if (!String.IsNullOrEmpty(_serverResponse))
            {
                <p class="error-detail-label">Odpověď serveru</p>
                <pre>@_serverResponse</pre>
            }
            <p class="error-detail-label">Výjimka</p>
            <pre>@Exception.ToString()</pre>
        </details>
    }
</div>
