<Project Sdk="Azure.Functions.Sdk">

	<PropertyGroup>
		<AssemblyName>KandaEu.Volejbal.Api</AssemblyName>
		<RootNamespace>KandaEu.Volejbal.Api</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1705;1591</NoWarn>

		<!-- ReadyToRun jen při publish s konkrétním RID (CI publikuje linux-x64). Předkompilace do nativního
		     kódu je největší jednotlivá páka na studený start .NET isolated workeru, který je hlavním důvodem
		     přechodu na Flex Consumption. Nesmí se předávat jako globální CLI vlastnost - protékala by do
		     Web.Client (browser-wasm), který R2R nepodporuje. -->
		<PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>

		<!-- Workstation GC místo Server GC (SDK default) - Server GC alokuje heap + vyhrazené vlákno na každé
		     CPU jádro, což je na instanci Flex Consumption (512 MB / 0,25 core) zbytečná režie. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Havit.ApplicationInsights.DependencyCollector" />
		<PackageReference Include="Havit.AspNetCore.Mvc" />
		<PackageReference Include="Microsoft.ApplicationInsights.DependencyCollector" />
		<PackageReference Include="Microsoft.ApplicationInsights.WorkerService" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Contracts\Contracts.csproj" />
		<ProjectReference Include="..\DependencyInjection\DependencyInjection.csproj" />
		<ProjectReference Include="..\Facades\Facades.csproj" />
		<ProjectReference Include="..\Services\Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appsettings.Api.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appsettings.Api.Development.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
	</ItemGroup>

</Project>
