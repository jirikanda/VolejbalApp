# syntax=docker/dockerfile:1
# Multi-stage build pro VolejbalApp Web (Blazor Server).
# Web generuje při buildu typované klienty z WebAPI (OpenApiProjectReference),
# proto potřebuje celé repo. Build context je kořen repa, Dockerfile se předává přes -f:
#
#   docker build -f Dockerfile.web -t volejbalapp-web .
#   docker run --rm -p 8081:8080 -e ConnectionStrings__WebAPI="http://webapi:8080/" volejbalapp-web

# ---- build ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .

# Cache mount drží NuGet balíčky mezi buildy (restore netahá z netu při změně zdrojáku).
# Publikace WebPAI čte '/src/WebAPI/obj/project.assets.json' (bůh ví proč), aniž by restore provedla

RUN --mount=type=cache,target=/root/.nuget/packages \
        dotnet restore WebAPI/WebAPI.csproj
RUN --mount=type=cache,target=/root/.nuget/packages \
        dotnet publish Web/Web.csproj \
        --configuration Release \
        -p:ContinuousIntegrationBuild=true \
        --output /app/publish

# ---- runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
USER $APP_UID

EXPOSE 8080

COPY --from=build /app/publish ./
ENTRYPOINT ["dotnet", "KandaEu.Volejbal.Web.dll"]
