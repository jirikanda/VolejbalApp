{
	"ApplicationInsights": {
		"DeveloperMode": true
	},
	"AppSettings": {
		"SmtpExceptionMonitoring": {
			"Enabled": false
		}
	},
	"Logging": {
		"LogLevel": {
			// Výjimky namapované v ErrorToJsonConfig s markExceptionAsHandled: true (403, 422) si
			// ErrorToJsonMiddleware odbaví sám, takže se k logování v diagnostických middleware
			// (ExceptionHandler / DeveloperExceptionPage) nikdy nedostanou - jejich jediným záznamem
			// je LogDebug tohoto middleware. Proto ho v Development zapínáme.
			"Havit.AspNetCore.Mvc.ErrorToJson": "Debug"
		}
	},
	"ConnectionStrings": {
		"Database": "Data Source=(localdb)\\mssqllocaldb;Initial Catalog=VolejbalApp;Application Name=VolejbalApp-Web;Trust Server Certificate=True"
	}
}